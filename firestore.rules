rules_version = '2';

// 단계(phase): 0 준비, 1 미션 진행, 2 최종 지목, 3 투표, 4 집계, 5 공개
// 단계는 앞으로만 넘어갈 수 있다. 운영자도 3단계(투표) 전에는 앱에서 짝 정보를 읽을 수 없다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function cfg() { return get(/databases/$(database)/documents/config/app).data; }
    function phase() { return cfg().phase; }
    function isAdmin() { return signedIn() && request.auth.uid in cfg().admins; }
    function linked() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // 참여자(초대 코드로 명단에 연결된 계정) 또는 운영자. 가입만 한 외부 계정은 아무것도 못 읽게 한다.
    function member() { return linked() || isAdmin(); }
    // 배정 회차. 운영자가 다시 배정할 때마다 1씩 올라가고, 단서는 지금 회차 것만 읽고 쓸 수 있다.
    function assignVer() { return cfg().get('assignVer', 0); }
    function myPid() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.personId; }
    function teamOf(pid) { return get(/databases/$(database)/documents/roster/$(pid)).data.team; }
    function myReceiver() { return get(/databases/$(database)/documents/assignments/$(myPid())).data.receiverPid; }
    function codeDoc(code) { return get(/databases/$(database)/documents/codes/$(code)).data; }

    match /config/app {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.phase == 0;
      allow update: if isAdmin() && request.resource.data.phase >= resource.data.phase;
    }

    // 명단: 이름, 팀, 연결된 계정(uid). 연결 전 계정은 읽을 수 없다(초대 코드 연결은 읽지 않고 바로 쓴다).
    match /roster/{pid} {
      allow read: if member();
      allow create, delete: if isAdmin() && phase() == 0;
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.uid == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'inviteUsed'])
            && request.resource.data.uid == request.auth.uid
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteUsed)).data.personId == pid);
    }

    // 참여자 화면용 명단 요약(이름·팀·근무지). 운영 화면이 명단과 다르면 다시 쓴다. 읽기 수를 줄이려고 둔다.
    match /public/{docId} {
      allow read: if member();
      allow write: if isAdmin();
    }

    // 초대 코드 -> 명단 연결
    match /invites/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    // 계정 ↔ 명단 연결. 본인과 운영자만 읽는다(운영 화면에 "연결된 메일"로 보임).
    // email은 있으면 로그인한 계정의 메일과 같아야 한다(남의 메일로 꾸밀 수 없게). 없는 문서는 예전 가입분.
    function emailOk() {
      return request.resource.data.get('email', null) == null
        || request.resource.data.email == request.auth.token.email;
    }
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow create: if request.auth.uid == uid
        && get(/databases/$(database)/documents/roster/$(request.resource.data.personId)).data.uid == uid
        && emailOk();
      allow update: if request.auth.uid == uid
        && request.resource.data.personId == resource.data.personId
        && emailOk();
      // 운영자 "연결 해제": 엉뚱한 사람이 연결됐거나 메일·비밀번호 문제로 새 계정으로 옮길 때.
      // 지우면 그 계정은 다시 "연결 전"이 되어 아무것도 못 읽는다.
      allow delete: if isAdmin();
    }

    // 캐릭터 선택: 참여자는 모두 볼 수 있고 본인만 바꾼다.
    match /avatars/{pid} {
      allow read: if member();
      allow write: if linked() && myPid() == pid
        && request.resource.data.avatar is int
        && request.resource.data.avatar >= 0 && request.resource.data.avatar < 8;
    }

    // 프로필 답변은 본인만. 단서는 clues 컬렉션으로 따로 전달된다.
    match /profiles/{pid} {
      allow read, write: if linked() && myPid() == pid;
    }

    // 짝 정보: 마니또 본인만 읽음. 운영자는 투표 단계부터.
    match /assignments/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin() && phase() >= 3;
      allow write: if isAdmin() && phase() == 0;
    }
    match /giverCodes/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin() && phase() >= 3;
      allow write: if isAdmin() && phase() == 0;
    }
    // 인증 코드 -> 받는 사람. 받는 사람 본인만 자기 코드 확인 가능.
    match /codes/{code} {
      allow get: if linked() && resource.data.receiverPid == myPid();
      allow read: if isAdmin() && phase() >= 3;
      allow write: if isAdmin() && phase() == 0;
    }

    // 받는 사람의 인증(코드 + 후기). 참여자에게 익명 피드로 공개된다.
    match /redemptions/{code} {
      allow read: if member();
      allow create: if linked() && phase() == 1
        && codeDoc(code).receiverPid == myPid()
        && request.resource.data.receiverPid == myPid()
        && request.resource.data.slot == codeDoc(code).slot
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 20
        && request.resource.data.review.size() <= 500
        && request.resource.data.voided == false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided']);
    }

    // 받는 사람 -> 마니또 익명 감사 답장
    match /thanks/{code} {
      allow read: if member();
      allow create: if linked()
        && codeDoc(code).receiverPid == myPid()
        && exists(/databases/$(database)/documents/redemptions/$(code))
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200;
    }

    // 마니또 -> 받는 사람 알림/쪽지. 보낸 사람 정보는 저장하지 않는다.
    match /deliveries/{id} {
      allow read: if linked() && resource.data.receiverPid == myPid();
      allow read: if isAdmin() && phase() >= 4;
      allow create: if linked() && phase() == 1
        && request.resource.data.receiverPid == myReceiver()
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500;
    }

    // 미션 슬롯 잠금 (도전 미션 응모권 보호)
    //  - 완료 표시(done)는 되돌릴 수 없다.
    //  - 완료했거나, 완료 표시 전이라도 그 슬롯 코드가 이미 인증된 1·2주차 슬롯은 고른 카드(난이도)를 바꿀 수 없다.
    //    (쪽지로 코드를 먼저 보내 인증받은 뒤 도전 카드로 바꾸는 것을 막는다)
    //  - 3주차 칭찬 슬롯에는 칭찬 카드만 들어간다(도전 응모권 없음).
    function choiceIn(d, s) { return d.get(['choices', s], null); }
    function doneIn(d, s) { return d.get(['done', s], false) == true; }
    function slotRedeemed(pid, s) {
      return exists(/databases/$(database)/documents/redemptions/$(get(/databases/$(database)/documents/giverCodes/$(pid)).data.codes[s]));
    }
    function missionSlotOk(pid, before, s) {
      return !(doneIn(before, s) && !doneIn(request.resource.data, s))
        && (choiceIn(request.resource.data, s) == choiceIn(before, s)
            || !(doneIn(before, s) || slotRedeemed(pid, s)));
    }
    function praiseSlotOk(before) {
      return !(doneIn(before, '3') && !doneIn(request.resource.data, '3'))
        && (choiceIn(request.resource.data, '3') == null
            || choiceIn(request.resource.data, '3').get('level', null) == 'praise');
    }
    function missionsOk(pid, before) {
      return missionSlotOk(pid, before, '1') && missionSlotOk(pid, before, '2') && praiseSlotOk(before);
    }
    match /giverMissions/{pid} {
      allow read: if linked() && myPid() == pid;
      allow read: if isAdmin() && phase() >= 3;
      allow create: if linked() && myPid() == pid && missionsOk(pid, {});
      allow update: if linked() && myPid() == pid && missionsOk(pid, resource.data);
    }

    // 팀 현황판용 진행 상황
    match /progress/{pid} {
      allow read: if linked() && (teamOf(pid) == teamOf(myPid()) || isAdmin());
      allow read: if isAdmin();
      allow write: if linked() && myPid() == pid
        && request.resource.data.get('doneCount', 0) <= 3;
    }

    // 단서: 문서 ID = 받는사람ID_순번. 공개된 개수만큼만 읽을 수 있다.
    // 다시 배정하면 지난 회차 단서(예전 마니또의 답)는 읽을 수 없고, 새 마니또가 앱을 열 때 지금 회차로 다시 쓴다.
    match /clues/{id} {
      allow get: if linked()
        && resource.data.receiverPid == myPid()
        && resource.data.idx < cfg().cluesReleased
        && resource.data.get('ver', -1) == assignVer();
      allow create, update: if linked()
        && request.resource.data.ver == assignVer()
        && request.resource.data.receiverPid == myReceiver()
        && request.resource.data.idx is int
        && request.resource.data.idx >= 0 && request.resource.data.idx < 6
        && id == request.resource.data.receiverPid + '_' + string(request.resource.data.idx);
    }

    match /nudges/{receiverPid} {
      allow read: if member();
      allow write: if isAdmin();
    }

    match /guesses/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin() && phase() >= 3;
      allow write: if linked() && myPid() == pid && phase() == 2
        && request.resource.data.guessPid != pid;
    }

    match /voteCards/{cardId} {
      allow read: if member() && phase() >= 3;
      allow write: if isAdmin() && phase() == 3;
    }
    match /cardOwners/{cardId} {
      allow read, write: if isAdmin() && phase() >= 3;
    }
    match /adminEval/{cardId} {
      allow read, write: if isAdmin() && phase() >= 3;
    }
    match /votes/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin() && phase() >= 4;
      allow write: if linked() && myPid() == pid && phase() == 3
        && request.resource.data.cardIds is list
        && request.resource.data.cardIds.size() <= 3;
    }

    // 운영 메모: 재배정 시 지울 코드 목록(짝 정보는 없음)
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    match /results/{docId} {
      allow read: if (linked() && phase() >= 5) || isAdmin();
      allow write: if isAdmin() && phase() >= 4;
    }
  }
}
