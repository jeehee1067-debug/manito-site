rules_version = '2';

// 단계(phase): 0 준비, 1 미션 진행, 2 최종 지목, 3 투표, 4 집계, 5 공개
// 단계는 한 칸씩 앞으로만 넘어간다.
// 운영자(공동 운영자 포함)는 참여하지 않는 계정이다. 명단에 연결할 수 없고, 짝·진행 상황·지목을 언제든 읽는다.
// 참여자는 자기 것만 읽는다. 익명 피드(feed)에는 받는 사람 정보가 없다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function cfg() { return get(/databases/$(database)/documents/config/app).data; }
    function phase() { return cfg().phase; }
    // 열린 주차(1~3). 인증·완료 알림·카드 고르기는 이 주차까지만 된다.
    function week() { return cfg().get('week', 1); }
    function isAdmin() { return signedIn() && request.auth.uid in cfg().admins; }
    function linked() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // 참여자(초대 코드로 명단에 연결된 계정) 또는 운영자. 가입만 한 외부 계정은 아무것도 못 읽게 한다.
    function member() { return linked() || isAdmin(); }
    // 배정 회차. 운영자가 다시 배정할 때마다 1씩 올라가고, 단서는 지금 회차 것만 읽고 쓸 수 있다.
    function assignVer() { return cfg().get('assignVer', 0); }
    function myPid() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.personId; }
    function myReceiver() { return get(/databases/$(database)/documents/assignments/$(myPid())).data.receiverPid; }
    function codeDoc(code) { return get(/databases/$(database)/documents/codes/$(code)).data; }
    // 내가 마니또로서 받은 코드 { '1': 코드, '2': 코드, '3': 코드 }
    function myGiverCodes() { return get(/databases/$(database)/documents/giverCodes/$(myPid())).data.codes; }
    // 내 앞으로 발급된 코드(내 마니또가 가진 코드). 참여자는 이 문서를 읽을 수 없고 규칙만 쓴다.
    function myInboxCodes() { return get(/databases/$(database)/documents/receiverCodes/$(myPid())).data.codes; }

    // 게시된 규칙의 버전 확인용. 운영 화면이 이 경로를 읽어 보고, 거부되면 "콘솔의 규칙이 예전 것"이라고 알려 준다.
    // 화면이 쓰는 경로·값의 모양을 바꿀 때 src/lib/constants.js의 RULES_VERSION과 같이 올린다.
    match /rulesVersion/{v} {
      allow get: if signedIn() && v == '20261113';
    }

    // ── 설정 ──────────────────────────────────────────────────────────────
    // 단계는 그대로이거나 한 칸 앞으로만. 공개(5)로 넘어가려면 집계 결과가 있어야 한다.
    function phaseStepOk() {
      let before = resource.data.phase;
      let after = request.resource.data.phase;
      return after == before
        || (after == before + 1
            && (after < 5 || exists(/databases/$(database)/documents/results/public)));
    }
    // 운영자는 한 번에 한 계정씩 늘릴 수 있고, 명단에 연결된 계정(참여자)은 운영자가 될 수 없다. 운영자가 0명이 될 수 없다.
    function adminsOk() {
      let added = request.resource.data.admins.removeAll(resource.data.admins);
      return request.resource.data.admins is list
        && request.resource.data.admins.size() > 0
        && (added.size() == 0
            || (added.size() == 1 && !exists(/databases/$(database)/documents/users/$(added[0]))));
    }
    // 주차는 1~3. 단서는 줄일 수 없고, 주차마다 2개까지만 공개된다(공개 개수 ≤ 2 × 주차).
    function weekCluesOk() {
      let w = request.resource.data.get('week', 1);
      let c = request.resource.data.get('cluesReleased', 0);
      let c0 = resource.data.get('cluesReleased', 0);
      return w is int && w >= 1 && w <= 3
        && c is int && c >= c0 && c <= 6
        && (c == c0 || c <= 2 * w);
    }
    match /config/app {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.phase == 0;
      allow update: if isAdmin() && phaseStepOk() && adminsOk() && weekCluesOk();
    }

    // ── 명단·계정 ─────────────────────────────────────────────────────────
    // 명단 원본(연결된 계정 uid, 수상 제외·중도 이탈 표시 포함)은 운영자만 읽는다.
    // 참여자 화면은 public/roster 요약(이름·근무지·파트)만 읽고, 초대 코드 연결은 명단을 읽지 않고 바로 쓴다.
    match /roster/{pid} {
      allow read: if isAdmin();
      allow create, delete: if isAdmin() && phase() == 0;
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.uid == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'inviteUsed'])
            && request.resource.data.uid == request.auth.uid
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteUsed)).data.personId == pid);
    }

    // public/roster: 참여자 화면용 명단 요약(이름·근무지·파트). 운영 화면이 명단과 다르면 다시 쓴다. 읽기 수를 줄이려고 둔다.
    // public/board:  파트 대항전 주간 순위. 운영자가 단서 공개 때 발표한다.
    match /public/{docId} {
      allow read: if member();
      allow write: if isAdmin();
    }

    // 초대 코드 -> 명단 연결
    match /invites/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    // 계정 ↔ 명단 연결. 본인과 운영자만 읽는다(운영 화면에 "연결된 메일"로 보임).
    // email은 있으면 로그인한 계정의 메일과 같아야 한다(남의 메일로 꾸밀 수 없게). 없는 문서는 예전 가입분.
    function emailOk() {
      return request.resource.data.get('email', null) == null
        || request.resource.data.email == request.auth.token.email;
    }
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      // 운영자 계정은 명단에 연결할 수 없다(운영자는 참여하지 않는다).
      allow create: if request.auth.uid == uid
        && !isAdmin()
        && get(/databases/$(database)/documents/roster/$(request.resource.data.personId)).data.uid == uid
        && emailOk();
      allow update: if request.auth.uid == uid
        && request.resource.data.personId == resource.data.personId
        && emailOk();
      // 운영자 "연결 해제": 엉뚱한 사람이 연결됐거나 메일·비밀번호 문제로 새 계정으로 옮길 때.
      // 지우면 그 계정은 다시 "연결 전"이 되어 아무것도 못 읽는다.
      allow delete: if isAdmin();
    }

    // 캐릭터 선택: 참여자는 모두 볼 수 있고 본인만 바꾼다.
    match /avatars/{pid} {
      allow read: if member();
      allow write: if linked() && myPid() == pid
        && request.resource.data.avatar is int
        && request.resource.data.avatar >= 0 && request.resource.data.avatar < 8;
    }

    // 프로필 답변은 본인만. 단서는 clues 컬렉션으로 따로 전달된다.
    match /profiles/{pid} {
      allow read, write: if linked() && myPid() == pid;
    }

    // ── 짝과 코드 ─────────────────────────────────────────────────────────
    // 짝 정보: 마니또 본인과 운영자만 읽는다. 배정은 준비 단계에만 쓴다.
    match /assignments/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow write: if isAdmin() && phase() == 0;
    }
    match /giverCodes/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow write: if isAdmin() && phase() == 0;
    }
    // 인증 코드 -> 받는 사람. 받는 사람 본인만 자기 코드 확인 가능.
    match /codes/{code} {
      allow get: if linked() && resource.data.receiverPid == myPid();
      allow read: if isAdmin();
      allow write: if isAdmin() && phase() == 0;
    }
    // 받는 사람 -> 그 사람 앞으로 발급된 코드 { codes: { '1': 코드, '2': 코드, '3': 코드 } } (giverCodes를 받는 사람 기준으로 뒤집은 것).
    // 피드 글이 그 사람의 실제 인증에 딸린 것인지 규칙이 확인할 때 쓴다. 참여자는 읽을 수 없다(아직 안 받은 코드가 보이면 안 된다).
    // 배정 때 같이 쓰고, 예전 방식으로 배정된 자료는 운영 화면이 채워 넣는다.
    match /receiverCodes/{pid} {
      allow read, write: if isAdmin();
    }

    // ── 인증과 익명 피드 ──────────────────────────────────────────────────
    // 받는 사람의 인증(코드 + 후기). 받는 사람 정보와 코드가 들어 있어서 꼭 필요한 사람만 읽는다:
    // 인증한 받는 사람, 그 코드를 가진 마니또, 운영자. 다른 참여자에게는 feed 문서만 보인다.
    match /redemptions/{code} {
      allow get: if linked() && codeDoc(code).receiverPid == myPid();
      allow get: if linked() && code in myGiverCodes().values();
      allow list: if linked() && resource.data.receiverPid == myPid();
      allow read: if isAdmin();
      allow create: if linked() && phase() == 1
        && codeDoc(code).receiverPid == myPid()
        && codeDoc(code).slot <= week()
        && request.resource.data.keys().hasOnly(['receiverPid', 'slot', 'review', 'voided', 'feedId', 'createdAt'])
        && request.resource.data.receiverPid == myPid()
        && request.resource.data.slot == codeDoc(code).slot
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 20
        && request.resource.data.review.size() <= 500
        && request.resource.data.voided == false
        && request.resource.data.feedId is string
        && request.resource.data.feedId.size() >= 10 && request.resource.data.feedId.size() <= 40
        // 피드 글과 한 묶음(batch)으로만 만들 수 있다
        && existsAfter(/databases/$(database)/documents/feed/$(request.resource.data.feedId));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided']);
    }

    // 익명 피드. 받는 사람 정보도 코드도 없다: { slot, review, voided, createdAt, thanks? }, 문서 ID는 무작위.
    // 인증과 한 묶음(batch)으로 만들어야 한다: 그 주차에 내 앞으로 발급된 코드의 인증이 이 글을 가리키고 후기가 같아야 통과한다.
    // (인증 없이 피드에 글만 올리거나 남의 인증에 글을 붙일 수 없다)
    function myRedemptionAfter(slot) {
      return getAfter(/databases/$(database)/documents/redemptions/$(myInboxCodes()[string(slot)])).data;
    }
    match /feed/{id} {
      allow read: if member();
      allow create: if linked() && phase() == 1
        && request.resource.data.keys().hasOnly(['slot', 'review', 'voided', 'createdAt'])
        && request.resource.data.slot is int
        && request.resource.data.voided == false
        && request.resource.data.createdAt == request.time
        && myRedemptionAfter(request.resource.data.slot).feedId == id
        && myRedemptionAfter(request.resource.data.slot).review == request.resource.data.review;
      // 감사 답장: 그 글을 쓴 받는 사람이 한 번만 붙인다.
      allow update: if linked()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thanks'])
        && resource.data.get('thanks', null) == null
        && request.resource.data.thanks is string
        && request.resource.data.thanks.size() > 0
        && request.resource.data.thanks.size() <= 200
        && myRedemptionAfter(resource.data.slot).feedId == id;
      // 운영자의 인증 무효 처리(인증 문서와 같이 바꾼다)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided']);
    }

    // 마니또 -> 받는 사람 알림/쪽지. 보낸 사람 정보는 저장하지 않는다.
    //  mission: 1·2주차 완료 알림, praise: 3주차 칭찬 카드, note: 완료한 주차에 더 보내는 쪽지(3일 연속 쪽지 카드용)
    match /deliveries/{id} {
      allow read: if linked() && resource.data.receiverPid == myPid();
      allow read: if isAdmin() && phase() >= 4;
      allow create: if linked() && phase() == 1
        && request.resource.data.receiverPid == myReceiver()
        && request.resource.data.slot is int
        && request.resource.data.slot >= 1 && request.resource.data.slot <= week()
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && ((request.resource.data.kind == 'mission' && request.resource.data.slot < 3)
            || (request.resource.data.kind == 'praise' && request.resource.data.slot == 3)
            || (request.resource.data.kind == 'note'
                && request.resource.data.message.size() > 0
                && doneIn(get(/databases/$(database)/documents/giverMissions/$(myPid())).data, string(request.resource.data.slot))));
    }

    // 미션 슬롯 잠금 (도전 미션 응모권 보호)
    //  - 미션 진행 단계에만, 열린 주차의 슬롯만 바꿀 수 있다(아직 안 열린 주차의 카드 고르기·완료 표시는 거부).
    //  - 완료 표시(done)는 되돌릴 수 없다.
    //  - 완료했거나, 완료 표시 전이라도 그 슬롯 코드가 이미 인증된 1·2주차 슬롯은 고른 카드(난이도)를 바꿀 수 없다.
    //    (쪽지로 코드를 먼저 보내 인증받은 뒤 도전 카드로 바꾸는 것을 막는다)
    //  - 3주차 칭찬 슬롯에는 칭찬 카드만 들어간다(도전 응모권 없음).
    function choiceIn(d, s) { return d.get(['choices', s], null); }
    function doneIn(d, s) { return d.get(['done', s], false) == true; }
    function slotSame(before, s) {
      return choiceIn(request.resource.data, s) == choiceIn(before, s)
        && doneIn(request.resource.data, s) == doneIn(before, s);
    }
    function slotRedeemed(pid, s) {
      return exists(/databases/$(database)/documents/redemptions/$(get(/databases/$(database)/documents/giverCodes/$(pid)).data.codes[s]));
    }
    function missionSlotOk(pid, before, s) {
      return slotSame(before, s)
        || (int(s) <= week()
            && !(doneIn(before, s) && !doneIn(request.resource.data, s))
            && (choiceIn(request.resource.data, s) == choiceIn(before, s)
                || !(doneIn(before, s) || slotRedeemed(pid, s))));
    }
    function praiseSlotOk(before) {
      return slotSame(before, '3')
        || (3 <= week()
            && !(doneIn(before, '3') && !doneIn(request.resource.data, '3'))
            && (choiceIn(request.resource.data, '3') == null
                || choiceIn(request.resource.data, '3').get('level', null) == 'praise'));
    }
    function missionsOk(pid, before) {
      return missionSlotOk(pid, before, '1') && missionSlotOk(pid, before, '2') && praiseSlotOk(before);
    }
    match /giverMissions/{pid} {
      allow read: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow create: if linked() && myPid() == pid && phase() == 1 && missionsOk(pid, {});
      allow update: if linked() && myPid() == pid && phase() == 1 && missionsOk(pid, resource.data);
    }

    // 진행 상황(완료 알린 미션 수, 프로필 작성, 최근 접속 등): 본인과 운영자만 읽는다.
    // 다른 참여자에게 실시간으로 보이면, 내가 미션을 받은 순간 누구 숫자가 올랐는지로 마니또가 드러난다.
    // 파트별 순위는 운영자가 주 1회 public/board에 발표한 것만 본다.
    // 완료 수는 열린 주차를 넘겨 올릴 수 없다(그대로 두는 것은 된다).
    match /progress/{pid} {
      allow read: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow create: if linked() && myPid() == pid
        && request.resource.data.get('doneCount', 0) <= week();
      allow update: if linked() && myPid() == pid
        && (request.resource.data.get('doneCount', 0) <= week()
            || request.resource.data.get('doneCount', 0) == resource.data.get('doneCount', 0));
    }

    // "받은 게 없어요" 신고: 마니또가 완료를 알렸는데 받은 것이 없을 때 받는 사람이 주차별로 남긴다.
    // 문서 ID = 받는사람ID_주차. 본인, 그 사람의 마니또, 운영자만 읽는다.
    match /reports/{rid} {
      allow get: if linked() && rid.split('_')[0] == myPid();
      allow get: if linked() && rid.split('_')[0] == myReceiver();
      allow read: if isAdmin();
      allow create: if linked() && phase() >= 1 && phase() <= 3
        && request.resource.data.keys().hasOnly(['receiverPid', 'slot', 'createdAt'])
        && request.resource.data.receiverPid == myPid()
        && request.resource.data.slot is int
        && request.resource.data.slot >= 1 && request.resource.data.slot <= week()
        && rid == myPid() + '_' + string(request.resource.data.slot);
      allow delete: if linked() && rid.split('_')[0] == myPid() && phase() <= 3;
    }
    // 운영자의 주차별 확인 결과: received(받았음 → 마니또의 미션 인정) / missing(못 받음 → 받는 사람에게 보상).
    // 신고가 없어도 남길 수 있다(받고도 인증하지 않은 경우). 집계 단계까지 바꿀 수 있다.
    match /verdicts/{rid} {
      allow get: if linked() && rid.split('_')[0] == myPid();
      allow get: if linked() && rid.split('_')[0] == myReceiver();
      allow read: if isAdmin();
      allow create, update: if isAdmin() && phase() >= 1 && phase() <= 4
        && request.resource.data.verdict in ['received', 'missing']
        && request.resource.data.slot is int
        && request.resource.data.slot >= 1 && request.resource.data.slot <= 3
        && rid == request.resource.data.receiverPid + '_' + string(request.resource.data.slot);
      allow delete: if isAdmin() && phase() >= 1 && phase() <= 4;
    }

    // 단서: 문서 ID = 받는사람ID_순번.
    //  - 0~5번: 마니또가 자기 프로필 답을 대상 앞으로 쓴다. 운영자가 공개한 개수만큼만 받는 사람이 읽는다.
    //  - 6번(파트 단서): 배정할 때 운영자 브라우저가 "마니또의 파트"를 써 둔다.
    //    최종 지목 단계(2)부터 받는 사람이 읽는다. 참여자는 쓸 수 없어서 거짓으로 바꿀 수 없다.
    // 다시 배정하면 지난 회차 단서(예전 마니또의 답)는 읽을 수 없고, 새 마니또가 앱을 열 때 지금 회차로 다시 쓴다.
    match /clues/{id} {
      allow get: if linked()
        && resource.data.receiverPid == myPid()
        && resource.data.get('ver', -1) == assignVer()
        && ((resource.data.idx < 6 && resource.data.idx < cfg().cluesReleased)
            || (resource.data.idx == 6 && phase() >= 2));
      // 비어 있던 칸은 늦게라도 쓸 수 있다(공개된 칸이어도).
      allow create: if clueWriteOk(id);
      // 이미 공개된 칸(idx < cluesReleased)은 답을 바꿀 수 없다(대상이 본 단서가 나중에 바뀌지 않게).
      // 단, 같은 답으로 다시 쓰기(프로필 저장 때 6칸을 다시 씀)와
      // 지난 회차 단서를 지금 회차로 덮어쓰기(다시 배정한 경우)는 된다.
      allow update: if clueWriteOk(id)
        && (request.resource.data.idx >= cfg().get('cluesReleased', 0)
            || request.resource.data.answer == resource.data.answer
            || resource.data.get('ver', -1) != assignVer());
      allow create, update: if isAdmin() && phase() == 0
        && request.resource.data.idx == 6
        && request.resource.data.ver is int
        && request.resource.data.answer is string
        && request.resource.data.answer.size() > 0 && request.resource.data.answer.size() <= 40
        && id == request.resource.data.receiverPid + '_6';
    }
    function clueWriteOk(id) {
      return linked()
        && request.resource.data.ver == assignVer()
        && request.resource.data.receiverPid == myReceiver()
        && request.resource.data.idx is int
        && request.resource.data.idx >= 0 && request.resource.data.idx < 6
        && request.resource.data.answer is string
        && request.resource.data.answer.size() > 0 && request.resource.data.answer.size() <= 60
        && id == request.resource.data.receiverPid + '_' + string(request.resource.data.idx);
    }

    match /nudges/{receiverPid} {
      allow read: if member();
      allow write: if isAdmin();
    }

    match /guesses/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow write: if linked() && myPid() == pid && phase() == 2
        && request.resource.data.guessPid != pid;
    }

    match /voteCards/{cardId} {
      allow read: if member() && phase() >= 3;
      allow write: if isAdmin() && phase() == 3;
    }
    match /cardOwners/{cardId} {
      allow read, write: if isAdmin() && phase() >= 3;
    }
    match /adminEval/{cardId} {
      allow read, write: if isAdmin() && phase() >= 3;
    }
    match /votes/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin() && phase() >= 4;
      allow write: if linked() && myPid() == pid && phase() == 3
        && request.resource.data.cardIds is list
        && request.resource.data.cardIds.size() <= 3;
    }

    // 운영 메모: 재배정 시 지울 코드 목록
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    // 결과. 집계 단계(4)에는 통째로 다시 쓸 수 있지만 추첨 결과(draws)는 비어 있어야 한다.
    // 공개 단계(5)에는 추첨 결과만, 그것도 새 칸을 더하는 것만 된다(이미 뽑은 결과를 바꾸거나 지울 수 없다).
    function drawsOf(d) { return d.get('draws', {}); }
    match /results/{docId} {
      allow read: if (linked() && phase() >= 5) || isAdmin();
      allow create, update: if isAdmin() && phase() == 4
        && drawsOf(request.resource.data).size() == 0;
      allow update: if isAdmin() && phase() == 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['draws'])
        && drawsOf(request.resource.data).diff(drawsOf(resource.data)).removedKeys().size() == 0
        && drawsOf(request.resource.data).diff(drawsOf(resource.data)).changedKeys().size() == 0;
    }
  }
}
