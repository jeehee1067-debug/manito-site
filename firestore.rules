rules_version = '2';

// 단계(phase): 0 준비, 1 미션 진행, 2 최종 지목, 3 투표, 4 집계, 5 공개
// 단계는 한 칸씩 앞으로만 넘어간다.
// 운영자(공동 운영자 포함)는 참여하지 않는 계정이다. 명단에 연결할 수 없고, 짝·진행 상황·지목을 언제든 읽는다.
// 참여자는 자기 것만 읽는다. 익명 피드(feed)에는 받는 사람 정보가 없다.
// 참여자가 반복해서 고칠 수 있는 문서에는 쓴 횟수(n)를 1씩 올려서 같이 써야 한다(bumped).
// 무료 한도(하루 쓰기 2만 건)를 일부러 소진하는 사람이 있으면 운영 화면에서 누구 문서인지 보인다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function cfg() { return get(/databases/$(database)/documents/config/app).data; }
    function phase() { return cfg().phase; }
    // 열린 주차(1~3). 인증·완료 알림·카드 고르기는 이 주차까지만 된다.
    function week() { return cfg().get('week', 1); }
    function isAdmin() { return signedIn() && request.auth.uid in cfg().admins; }
    // 처음 운영자(admins[0]). 운영자 목록, 초대 코드, 계정 연결 해제처럼 "누가 누구인지"를 바꾸는 일은 처음 운영자만 한다
    // (공동 운영자가 자기 다른 계정을 참여자로 끼워 넣거나 운영자를 늘리는 것을 막는다).
    function isOwner() { return signedIn() && request.auth.uid == cfg().admins[0]; }
    function linked() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // 참여자(초대 코드로 명단에 연결된 계정) 또는 운영자. 가입만 한 외부 계정은 아무것도 못 읽게 한다.
    function member() { return linked() || isAdmin(); }
    // 배정 회차. 운영자가 다시 배정할 때마다 1씩 올라가고, 단서는 지금 회차 것만 읽고 쓸 수 있다.
    function assignVer() { return cfg().get('assignVer', 0); }
    function myPid() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.personId; }
    function myReceiver() { return get(/databases/$(database)/documents/assignments/$(myPid())).data.receiverPid; }
    function codeDoc(code) { return get(/databases/$(database)/documents/codes/$(code)).data; }
    // 내가 마니또로서 받은 코드 { '1': 코드, '2': 코드, '3': 코드 }
    function myGiverCodes() { return get(/databases/$(database)/documents/giverCodes/$(myPid())).data.codes; }
    // 내 앞으로 발급된 코드(내 마니또가 가진 코드). 참여자는 이 문서를 읽을 수 없고 규칙만 쓴다.
    function myInboxCodes() { return get(/databases/$(database)/documents/receiverCodes/$(myPid())).data.codes; }
    function myMissions() { return /databases/$(database)/documents/giverMissions/$(myPid()); }
    // 쓴 횟수(n)를 정확히 1 올렸는지. 새 문서는 1, 예전 문서(n 없음)는 0에서 시작한다.
    function bumped() {
      return request.resource.data.get('n', 0) == (resource == null ? 0 : resource.data.get('n', 0)) + 1;
    }
    // 문자열 길이 제한
    function shortStr(v, max) { return v is string && v.size() <= max; }

    // 게시된 규칙의 버전 확인용. 운영 화면이 이 경로를 읽어 보고, 거부되면 "콘솔의 규칙이 예전 것"이라고 알려 준다.
    // 화면이 쓰는 경로·값의 모양을 바꿀 때 src/lib/constants.js의 RULES_VERSION과 같이 올린다.
    match /rulesVersion/{v} {
      allow get: if isAdmin() && v == '20261127';
    }

    // ── 설정 ──────────────────────────────────────────────────────────────
    // 단계는 그대로이거나 한 칸 앞으로만, 공개(5)가 마지막이다. 공개(5)로 넘어가려면 집계 결과가 있어야 한다.
    function phaseStepOk() {
      let before = resource.data.phase;
      let after = request.resource.data.phase;
      return after == before
        || (after == before + 1 && after <= 5
            && (after < 5 || exists(/databases/$(database)/documents/results/public)));
    }
    // 운영자 목록(과 메모)은 처음 운영자(admins[0])만 바꾼다. 처음 운영자는 목록에서 빠지지 않는다(공동 운영자가 내보낼 수 없다).
    // 한 번에 한 계정씩 늘릴 수 있고, 명단에 연결된 계정(참여자)은 운영자가 될 수 없다.
    function adminsOk() {
      let before = resource.data.admins;
      let after = request.resource.data.admins;
      let added = after.removeAll(before);
      return (after == before
              && request.resource.data.get('adminNotes', {}) == resource.data.get('adminNotes', {}))
        || (request.auth.uid == before[0]
            && after is list
            && after.size() > 0
            && after[0] == before[0]
            && (added.size() == 0
                || (added.size() == 1 && !exists(/databases/$(database)/documents/users/$(added[0])))));
    }
    // 주차는 1~3이고 한 번에 한 칸씩만 올린다(내리는 것은 된다). 단서는 줄일 수 없고, 한 번에 2개까지, 주차마다 2개까지만 공개된다(공개 개수 ≤ 2 × 주차).
    function weekCluesOk() {
      let w = request.resource.data.get('week', 1);
      let w0 = resource.data.get('week', 1);
      let c = request.resource.data.get('cluesReleased', 0);
      let c0 = resource.data.get('cluesReleased', 0);
      return w is int && w >= 1 && w <= 3 && w <= w0 + 1
        && c is int && c >= c0 && c <= 6 && c <= c0 + 2
        && (c == c0 || c <= 2 * w);
    }
    // 배정과 관련된 값(배정 회차, 같은 파트 제외 여부, 같은 근무지 여부)은 준비 단계에서만 바뀐다
    // (미션 중에 회차를 올리면 파트 단서를 못 읽게 되고, 공개된 단서를 다시 쓸 수 있게 된다).
    function assignFieldsOk() {
      return resource.data.phase == 0
        || (request.resource.data.get('assignVer', 0) == resource.data.get('assignVer', 0)
            && request.resource.data.get('partExcluded', null) == resource.data.get('partExcluded', null)
            && request.resource.data.get('siteMatched', null) == resource.data.get('siteMatched', null));
    }
    // 설정은 참여자·운영자만 읽는다(공지, 운영자 계정 번호·메모가 들어 있다).
    // 연결 전 계정은 "아직 설정이 없는지"만 알 수 있다(문서가 없을 때만 읽힘 → 첫 운영자 설정 화면).
    match /config/app {
      allow get: if member() || (signedIn() && resource == null);
      allow create: if signedIn()
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.phase == 0;
      allow update: if isAdmin() && phaseStepOk() && adminsOk() && weekCluesOk() && assignFieldsOk();
    }

    // ── 명단·계정 ─────────────────────────────────────────────────────────
    // 명단 원본(연결된 계정 uid, 수상 제외·중도 이탈 표시 포함)은 운영자만 읽는다.
    // 참여자 화면은 public/roster 요약(이름·근무지·파트)만 읽고, 초대 코드 연결은 명단을 읽지 않고 바로 쓴다.
    // 운영자는 명단을 고칠 수 있지만 연결된 계정(uid)은 비우는 것(연결 해제)만, 처음 운영자만 한다(다른 계정으로 바꿔 끼워 사칭하는 것 방지).
    // 초대 코드로 연결할 때는 아직 아무 이름에도 연결되지 않은 계정만(이미 연결된 사람이 남의 코드로 두 사람 몫을 가져가지 못하게).
    match /roster/{pid} {
      allow read: if isAdmin();
      allow create: if isOwner() && phase() == 0 && request.resource.data.get('uid', null) == null;
      allow delete: if isOwner() && phase() == 0;
      // 운영자: 연결 계정(uid)은 못 바꾸고(처음 운영자만 비울 수 있다), 메일(email)도 처음 운영자만 바꾼다
      // (공동 운영자가 남의 이름에 자기 메일을 적어 넣고 메일 인증으로 그 사람인 척 연결하지 못하게).
      allow update: if isAdmin()
        && (request.resource.data.get('uid', null) == resource.data.get('uid', null)
            || (isOwner() && request.resource.data.get('uid', null) == null))
        && (request.resource.data.get('email', null) == resource.data.get('email', null) || isOwner());
      // 참여자의 연결(아직 아무도 연결하지 않은 이름에, 자기 계정을, 한 계정은 한 이름만). 두 가지 길이 있다.
      function claimShapeOk(pid) {
        return signedIn()
          && resource.data.uid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'inviteUsed'])
          && request.resource.data.uid == request.auth.uid
          && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.personId == pid);
      }
      // (가) 회사 메일 인증: 인증을 마친 메일이 명단의 그 사람 메일과 같을 때. inviteUsed에는 '@mail'을 남긴다(src/lib/constants.js MAIL_LINK).
      allow update: if claimShapeOk(pid)
        && request.resource.data.inviteUsed == '@mail'
        && request.auth.token.email_verified == true
        && resource.data.get('email', null) != null
        && resource.data.email == request.auth.token.email;
      // (나) 초대 코드(메일이 오지 않을 때의 예비): 그 사람 앞으로 발급된 코드일 때
      allow update: if claimShapeOk(pid)
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteUsed)).data.personId == pid;
    }

    // 메일 → 명단 번호. 메일 인증을 마친 사람이 자기 이름을 찾는 데 쓴다(연결 전 계정은 명단을 읽을 수 없어서).
    // 자기 메일 한 건만 읽을 수 있고, 만들기·지우기·목록은 처음 운영자만(명단과 같이 쓴다).
    match /mailIndex/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow read, write: if isOwner();
    }

    // public/roster: 참여자 화면용 명단 요약(이름·근무지·파트). 운영 화면이 명단과 다르면 다시 쓴다. 읽기 수를 줄이려고 둔다.
    // public/board:  파트 대항전 주간 순위. 운영자가 단서 공개 때 발표한다.
    match /public/{docId} {
      allow read: if member();
      allow write: if isAdmin();
    }

    // 초대 코드 -> 명단 연결
    // 초대 코드: 만들기·지우기·목록 보기는 처음 운영자만.
    // (공동 운영자가 목록을 읽을 수 있으면, 아직 가입 안 한 사람의 코드로 다른 계정을 그 이름에 연결할 수 있다)
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isOwner();
      allow write: if isOwner();
    }

    // 계정 ↔ 명단 연결. 본인과 운영자만 읽는다(운영 화면에 "연결된 메일"로 보임).
    // email은 있으면 로그인한 계정의 메일과 같아야 한다(남의 메일로 꾸밀 수 없게). 없는 문서는 예전 가입분.
    function emailOk() {
      return request.resource.data.get('email', null) == null
        || request.resource.data.email == request.auth.token.email;
    }
    function userShapeOk() {
      return request.resource.data.keys().hasOnly(['personId', 'eliminated', 'email', 'n'])
        && request.resource.data.get('eliminated', []) is list
        && request.resource.data.get('eliminated', []).size() <= 100
        && request.resource.data.get('eliminated', []).join('').size() <= 2000; // 칸마다 pid 문자열만(큰 값을 넣어 운영 화면을 느리게 하지 못하게)
    }
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      // 운영자 계정은 명단에 연결할 수 없다(운영자는 참여하지 않는다).
      allow create: if request.auth.uid == uid
        && !isAdmin()
        && get(/databases/$(database)/documents/roster/$(request.resource.data.personId)).data.uid == uid
        && emailOk() && userShapeOk() && bumped();
      allow update: if request.auth.uid == uid
        && request.resource.data.personId == resource.data.personId
        && emailOk() && userShapeOk() && bumped();
      // 처음 운영자의 "연결 해제": 엉뚱한 사람이 연결됐거나 메일·비밀번호 문제로 새 계정으로 옮길 때.
      // 지우면 그 계정은 다시 "연결 전"이 되어 아무것도 못 읽는다.
      allow delete: if isOwner();
    }

    // 캐릭터 선택: 참여자는 모두 볼 수 있고 본인만 바꾼다.
    match /avatars/{pid} {
      allow read: if member();
      allow create, update: if linked() && myPid() == pid
        && request.resource.data.keys().hasOnly(['avatar', 'n'])
        && request.resource.data.avatar is int
        && request.resource.data.avatar >= 0 && request.resource.data.avatar < 8
        && bumped();
    }

    // 프로필 답변: 본인이 쓰고, 운영자도 읽는다(거짓 단서 확인용. 운영자는 참여하지 않는다). 단서는 clues 컬렉션으로 따로 전달된다.
    function answersOk(a) {
      return a is list && a.size() == 6
        && shortStr(a[0], 60) && shortStr(a[1], 60) && shortStr(a[2], 60)
        && shortStr(a[3], 60) && shortStr(a[4], 60) && shortStr(a[5], 60);
    }
    match /profiles/{pid} {
      allow read: if (linked() && myPid() == pid) || isAdmin();
      allow create, update: if linked() && myPid() == pid
        && request.resource.data.keys().hasOnly(['answers', 'updatedAt', 'n'])
        && request.resource.data.get('updatedAt', request.time) == request.time
        && answersOk(request.resource.data.answers)
        && bumped();
    }

    // 내 마니또에게 알려 줄 것: 좋아하는 간식(likes), 못 먹는 음식·알레르기(avoid), 받기 곤란한 것(nope).
    // 본인·내 마니또(나를 맡은 사람)·운영자만 읽는다. 간식 미션에서 알레르기 사고를 막고 선물 고르는 데 쓴다.
    match /prefs/{pid} {
      // 나를 맡은 마니또, 그리고 나에게 연결된 수호천사도 읽는다(간식 미션 알레르기 확인)
      allow get: if linked() && (myPid() == pid || myReceiver() == pid
        || (exists(/databases/$(database)/documents/angels/$(pid))
            && get(/databases/$(database)/documents/angels/$(pid)).data.angelPid == myPid()));
      allow read: if isAdmin();
      allow create, update: if linked() && myPid() == pid
        && request.resource.data.keys().hasOnly(['likes', 'avoid', 'nope', 'n'])
        && shortStr(request.resource.data.get('likes', ''), 100)
        && shortStr(request.resource.data.get('avoid', ''), 100)
        && shortStr(request.resource.data.get('nope', ''), 100)
        && bumped();
    }

    // ── 짝과 코드 ─────────────────────────────────────────────────────────
    // 짝 정보: 마니또 본인과 운영자만 읽는다. 배정은 준비 단계에만 쓴다.
    match /assignments/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow write: if isAdmin() && phase() == 0;
    }
    match /giverCodes/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow write: if isAdmin() && phase() == 0;
    }
    // 인증 코드 -> 받는 사람. 받는 사람 본인만 자기 코드 확인 가능.
    match /codes/{code} {
      allow get: if linked() && resource.data.receiverPid == myPid();
      allow read: if isAdmin();
      allow write: if isAdmin() && phase() == 0;
    }
    // 받는 사람 -> 그 사람 앞으로 발급된 코드 { codes: { '1': 코드, '2': 코드, '3': 코드 } } (giverCodes를 받는 사람 기준으로 뒤집은 것).
    // 피드 글이 그 사람의 실제 인증에 딸린 것인지 규칙이 확인할 때 쓴다. 참여자는 읽을 수 없다(아직 안 받은 코드가 보이면 안 된다).
    // 배정 때 같이 쓰고, 예전 방식으로 배정된 자료는 운영 화면이 채워 넣는다.
    match /receiverCodes/{pid} {
      allow read, write: if isAdmin();
    }

    // ── 인증과 익명 피드 ──────────────────────────────────────────────────
    // 받는 사람의 인증(코드 + 후기). 받는 사람 정보와 코드가 들어 있어서 꼭 필요한 사람만 읽는다:
    // 인증한 받는 사람, 그 코드를 가진 마니또, 운영자. 다른 참여자에게는 feed 문서만 보인다.
    match /redemptions/{code} {
      allow get: if linked() && codeDoc(code).receiverPid == myPid();
      allow get: if linked() && code in myGiverCodes().values();
      allow list: if linked() && resource.data.receiverPid == myPid();
      allow read: if isAdmin();
      // 미션 진행(1)과 최종 지목(2) 단계에: 미션이 마감된 뒤에도 지목이 마감될 때까지는 인증할 수 있다(마감 직전에 온 미션을 인증할 시간)
      allow create: if linked() && phase() >= 1 && phase() <= 2
        && codeDoc(code).receiverPid == myPid()
        && codeDoc(code).slot <= week()
        && request.resource.data.keys().hasOnly(['receiverPid', 'slot', 'review', 'voided', 'feedId', 'createdAt', 'cardMatch'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('cardMatch', true) is bool
        // 카드 확인은 마니또의 완료 알림(고른 카드가 들어 있다)이 있을 때만 남길 수 있다(카드를 보지 않고 "같다"고 할 수 없게)
        && (!('cardMatch' in request.resource.data)
          || exists(/databases/$(database)/documents/deliveries/$(myPid() + '_' + string(request.resource.data.slot))))
        && request.resource.data.receiverPid == myPid()
        && request.resource.data.slot == codeDoc(code).slot
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 20
        && request.resource.data.review.size() <= 500
        && request.resource.data.voided == false
        && request.resource.data.feedId is string
        && request.resource.data.feedId.size() >= 10 && request.resource.data.feedId.size() <= 40
        // 피드 글과 한 묶음(batch)으로만 만들 수 있다: 같은 묶음에서 새로 생기는 글이어야 한다(남의 기존 글을 가리킬 수 없다)
        && !exists(/databases/$(database)/documents/feed/$(request.resource.data.feedId))
        && existsAfter(/databases/$(database)/documents/feed/$(request.resource.data.feedId))
        // 그 글은 이 인증의 주차 것이어야 한다(한 묶음에서 두 주차 인증이 글 하나를 같이 가리키지 못하게)
        && getAfter(/databases/$(database)/documents/feed/$(request.resource.data.feedId)).data.slot == request.resource.data.slot;
      // 받는 사람의 나중 카드 확인: 완료 알림보다 먼저 인증해서 카드를 못 본 경우, 알림이 온 뒤 "받은 것이 그 카드와 같았는지"를 한 번만 남긴다.
      // (카드 추가분은 받는 사람이 카드를 보고 같다고 한 미션에만 붙는다)
      allow update: if linked() && resource.data.receiverPid == myPid() && phase() >= 1 && phase() <= 2
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cardMatch'])
        && !('cardMatch' in resource.data)
        && request.resource.data.cardMatch is bool
        && exists(/databases/$(database)/documents/deliveries/$(myPid() + '_' + string(resource.data.slot)));
      // 받는 사람의 후기·감사 답장 고치기(사용자가 정함, 11/23: 실수로 이름을 쓴 경우 등). 집계 전(단계 1~3)까지, 후기·답장 합쳐 3번(edits).
      // 피드 글과 한 묶음으로만: 보이는 글이면 feed.review를 같은 글로, 운영진이 가린 글이면 원문 자리(hiddenFeed)를 같은 글로 바꾸고,
      // 피드 글에 고친 시각(editedAt)을 남겨야 한다. 감사 답장만 고칠 때는 후기는 그대로 두고 edits만 1 올린다.
      allow update: if linked() && resource.data.receiverPid == myPid() && phase() >= 1 && phase() <= 3
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review', 'edits'])
        && request.resource.data.edits == resource.data.get('edits', 0) + 1
        && request.resource.data.edits <= 3
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 20
        && request.resource.data.review.size() <= 500
        && feedAfter(resource.data.feedId).get('editedAt', null) == request.time
        && ((feedAfter(resource.data.feedId).get('hidden', false) == false
              && feedAfter(resource.data.feedId).review == request.resource.data.review)
            || (feedAfter(resource.data.feedId).get('hidden', false) == true
              && feedAfter(resource.data.feedId).review == ''
              && getAfter(/databases/$(database)/documents/hiddenFeed/$(resource.data.feedId)).data.review == request.resource.data.review));
      // 운영자: 무효 처리, "카드와 다름" 판정 고치기(도전 추가분),
      // 고친 횟수(edits)를 0으로 되돌리기(가리거나 무효 처리할 때: 운영진이 지운 뒤에도 글쓴이가 다시 고쳐 쓸 수 있게, 사용자가 정함 11/23)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'cardMatch', 'edits'])
        && (request.resource.data.get('edits', 0) == resource.data.get('edits', 0) || request.resource.data.get('edits', 0) == 0)
        && request.resource.data.voided is bool
        && request.resource.data.get('cardMatch', true) is bool;
    }

    // 익명 피드. 받는 사람 정보도 코드도 없다: { slot, review, voided, createdAt, thanks?, hidden?, likes?, editedAt? }, 문서 ID는 무작위.
    // 인증과 한 묶음(batch)으로 만들어야 한다: 그 주차에 내 앞으로 발급된 코드의 인증이 이 글을 가리키고 후기가 같아야 통과한다.
    // (인증 없이 피드에 글만 올리거나 남의 인증에 글을 붙일 수 없다)
    function myRedemptionAfter(slot) {
      return getAfter(/databases/$(database)/documents/redemptions/$(myInboxCodes()[string(slot)])).data;
    }
    function myRedemptionNow(slot) {
      return get(/databases/$(database)/documents/redemptions/$(myInboxCodes()[string(slot)])).data;
    }
    function feedAfter(id) { return getAfter(/databases/$(database)/documents/feed/$(id)).data; }
    // 글쓴이의 고치기: 이 글을 가리키는 내 인증 문서의 고친 횟수(edits)가 같은 묶음에서 1 올라야 한다(횟수·단계·후기 길이는 인증 문서 규칙이 본다)
    function myEditOf(id, slot) {
      return myRedemptionAfter(slot).feedId == id
        && myRedemptionAfter(slot).get('edits', 0) == myRedemptionNow(slot).get('edits', 0) + 1;
    }
    match /feed/{id} {
      allow read: if member();
      allow create: if linked() && phase() >= 1 && phase() <= 2
        && request.resource.data.keys().hasOnly(['slot', 'review', 'voided', 'createdAt'])
        && request.resource.data.slot is int
        && request.resource.data.voided == false
        && request.resource.data.createdAt == request.time
        && myRedemptionAfter(request.resource.data.slot).feedId == id
        && myRedemptionAfter(request.resource.data.slot).review == request.resource.data.review;
      // 감사 답장: 그 글을 쓴 받는 사람이 한 번만 붙인다.
      allow update: if linked()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thanks'])
        && resource.data.get('thanks', null) == null
        && request.resource.data.thanks is string
        && request.resource.data.thanks.size() > 0
        && request.resource.data.thanks.size() <= 200
        && myRedemptionAfter(resource.data.slot).feedId == id
        && myRedemptionAfter(resource.data.slot).review == resource.data.review;
      // 글쓴이(받는 사람)의 후기·감사 답장 고치기: 인증 문서와 한 묶음으로(myEditOf), 고친 시각(editedAt)을 남긴다.
      //  보이는 글: 후기는 인증 문서의 후기와 같게, 감사 답장은 이미 있던 것만 고친다(지우기는 안 됨).
      //  가린 글: 피드 글의 후기는 빈 값 그대로 두고(원문 자리 hiddenFeed를 고친다) 감사 답장도 못 고친다.
      allow update: if linked() && phase() >= 1 && phase() <= 3
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review', 'thanks', 'editedAt'])
        && request.resource.data.editedAt == request.time
        && myEditOf(id, resource.data.slot)
        && ((resource.data.get('hidden', false) == false
              && request.resource.data.review == myRedemptionAfter(resource.data.slot).review)
            || (resource.data.get('hidden', false) == true
              && request.resource.data.review == resource.data.review))
        && (request.resource.data.get('thanks', null) == resource.data.get('thanks', null)
            || (resource.data.get('hidden', false) == false
              && resource.data.get('thanks', null) != null
              && request.resource.data.get('thanks', null) is string
              && request.resource.data.thanks.size() > 0
              && request.resource.data.thanks.size() <= 200));
      // 공감: 참여자는 글마다 한 번만(취소 없음, 쓰기 반복 방지). 공감 표시 feedLikes/{글ID}_{내pid}를 같은 묶음으로 만들어야 likes가 1 오른다.
      allow update: if linked() && phase() >= 1 && phase() <= 4
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes == resource.data.get('likes', 0) + 1
        && resource.data.voided == false && resource.data.get('hidden', false) == false
        && !exists(/databases/$(database)/documents/feedLikes/$(id + '_' + myPid()))
        && existsAfter(/databases/$(database)/documents/feedLikes/$(id + '_' + myPid()));
      // 운영자: 무효 처리(인증 문서와 같이 바꾼다), 피드에서만 가리기(hidden, 응모권과 무관), 감사 답장 지우기
      //  가리기: 후기를 비우고(review == '') 원문은 운영자만 읽는 hiddenFeed/{id}로 옮긴다. 피드 글은 참여자 누구나 읽을 수 있어서,
      //  hidden 표시만 하면 직접 요청으로는 내용이 그대로 보이기 때문이다. 다시 보이기는 hiddenFeed의 원문으로만 되돌린다.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'hidden', 'thanks', 'review'])
        && request.resource.data.voided is bool
        && request.resource.data.get('hidden', false) is bool
        && (!('thanks' in request.resource.data) || request.resource.data.thanks == resource.data.get('thanks', null))
        && (request.resource.data.get('hidden', false) == false || request.resource.data.review == '')
        && (request.resource.data.review == resource.data.review
            || (request.resource.data.review == ''
                && getAfter(/databases/$(database)/documents/hiddenFeed/$(id)).data.review == resource.data.review)
            || (resource.data.review == ''
                && request.resource.data.review == get(/databases/$(database)/documents/hiddenFeed/$(id)).data.review));
    }
    // 공감 표시: { pid, feedId, at }, 문서 ID "글ID_내pid". 본인·운영자만 읽는다(누가 어느 글에 공감했는지는 남에게 안 보임).
    match /feedLikes/{id} {
      allow list: if linked() && resource.data.pid == myPid();
      allow read: if isAdmin();
      allow create: if linked()
        && request.resource.data.keys().hasOnly(['pid', 'feedId', 'at'])
        && request.resource.data.pid == myPid()
        && request.resource.data.feedId is string
        && id == request.resource.data.feedId + '_' + myPid()
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/feed/$(request.resource.data.feedId)).data.get('likes', 0)
           == get(/databases/$(database)/documents/feed/$(request.resource.data.feedId)).data.get('likes', 0) + 1;
    }
    // 가린 피드 글의 원문(운영자만). { review }
    match /hiddenFeed/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['review'])
        && request.resource.data.review is string;
      // 가린 글의 글쓴이가 후기를 고치면 원문 자리도 같은 글로 바꾼다(운영진이 다시 보이게 하면 고친 글이 보인다).
      // 인증 문서와 한 묶음으로만(myEditOf, 인증 문서 규칙이 횟수·단계·길이를 본다). 글쓴이도 읽을 수는 없다.
      allow update: if linked() && phase() >= 1 && phase() <= 3
        && request.resource.data.keys().hasOnly(['review'])
        && get(/databases/$(database)/documents/feed/$(id)).data.get('hidden', false) == true
        && myEditOf(id, get(/databases/$(database)/documents/feed/$(id)).data.slot)
        && request.resource.data.review == myRedemptionAfter(get(/databases/$(database)/documents/feed/$(id)).data.slot).review;
    }

    // 운영진이 후기·답장을 가리거나 지우거나 무효 처리한 이유(사용자가 정함, 11/23: "무슨 이유로 삭제했는지 기록해서 그 사람이 보게").
    // { receiverPid, slot, hide?, thanks?, void? } (각각 { reason, at }), 문서 ID = 인증 코드.
    // 글쓴이(받는 사람)와 운영자만 읽는다(그 미션의 마니또는 못 읽는다: 이유에 마니또에 대한 추측이 들어 있을 수 있다).
    function modNoteOk(k) {
      return !(k in request.resource.data)
        || (resource != null && k in resource.data && request.resource.data[k] == resource.data[k])
        || (request.resource.data[k] is map
          && request.resource.data[k].keys().hasOnly(['reason', 'at'])
          && request.resource.data[k].reason is string
          && request.resource.data[k].reason.size() <= 300
          && request.resource.data[k].at == request.time);
    }
    match /modNotes/{code} {
      allow get, list: if linked() && resource.data.receiverPid == myPid();
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['receiverPid', 'slot', 'hide', 'thanks', 'void'])
        && request.resource.data.receiverPid == get(/databases/$(database)/documents/redemptions/$(code)).data.receiverPid
        && request.resource.data.slot == get(/databases/$(database)/documents/redemptions/$(code)).data.slot
        && modNoteOk('hide') && modNoteOk('thanks') && modNoteOk('void');
    }

    // 황금 카드 추첨 당첨(사용자가 정함, 11/23): { weeks: { '2': true, '3': true }, at }, 문서 ID = 당첨된 마니또의 명단 번호.
    // 운영자 화면이 그 주가 끝난 뒤 추첨해서 쓰고, 당첨된 본인과 운영자만 읽는다(누가 뽑혔는지는 송년회 전까지 비밀 —
    // 황금 카드를 받은 대상이 당첨자 명단으로 자기 마니또를 좁힐 수 있다). 추첨 기록은 meta/goldDraw, 주차별 추첨 여부·인원 수는 public/goldDraw.
    match /goldWins/{pid} {
      allow get: if linked() && pid == myPid();
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['weeks', 'at'])
        && request.resource.data.weeks is map
        && request.resource.data.weeks.keys().hasOnly(['2', '3'])
        && request.resource.data.weeks.values().hasOnly([true])
        && request.resource.data.at == request.time;
    }

    // 마니또 -> 받는 사람 알림/쪽지. 보낸 사람 정보는 저장하지 않는다.
    //  mission: 1·2주차 완료 알림, praise: 3주차 칭찬 카드
    //    → 문서 ID가 "받는사람_주차"로 정해져 있어 주차마다 한 번만 만들 수 있고, 완료 표시(giverMissions.done)와 한 묶음으로만 만든다.
    //      (완료 표시 없이 알림만 보내 받는 사람의 보상을 막고 운영자 화면에는 안 보이게 하는 것을 막는다)
    //  note: 완료한 주차에 더 보내는 쪽지(3일 연속 쪽지 카드용). giverMissions.notes[주차]를 1 올리는 것과 한 묶음으로만, 주차마다 5건까지.
    // 운영자는 언제든 읽고(괴롭힘 확인), 숨길 수 있다(hidden). 받는 사람은 쪽지를 신고할 수 있다(noteFlags).
    function noteCount(d, s) { return d.get(['notes', s], 0); }
    //  쪽지 문서 ID도 "받는사람_주차_n순번"으로 정해져 있어(순번 = 쪽지 수) 개수를 속일 수 없다.
    //  mission 알림에는 마니또가 고른 카드(card: 난이도·내용)가 같이 간다(받는 사람이 받은 것과 맞는지 확인 → 도전 추가분).
    // 3주차: 칭찬 한 줄만 보내면(choices['3'] = 칭찬 카드) 알림에 card가 없고,
    // 칭찬과 함께 보통·도전 카드를 골랐으면 그 카드(난이도·글)가 알림에 같이 있어야 한다(받는 사람이 카드를 보고 확인한다)
    function praiseCardOk() {
      let ch = choiceIn(getAfter(myMissions()).data, '3');
      return ch != null
        && ((ch.level == 'praise' && !('card' in request.resource.data))
            || (ch.level in ['normal', 'hard'] && missionCardOk('3')));
    }
    function missionCardOk(slot) {
      let ch = choiceIn(getAfter(myMissions()).data, slot);
      return ch != null
        && request.resource.data.card is map
        && request.resource.data.card.keys().hasOnly(['level', 'text'])
        && request.resource.data.card.level == ch.level
        && request.resource.data.card.text == ch.text;
    }
    match /deliveries/{id} {
      allow read: if linked() && resource.data.receiverPid == myPid();
      allow read, delete: if isAdmin();
      allow create: if linked() && phase() == 1
        && request.resource.data.keys().hasOnly(['receiverPid', 'slot', 'kind', 'message', 'code', 'card', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.receiverPid == myReceiver()
        && request.resource.data.slot is int
        && request.resource.data.slot >= 1 && request.resource.data.slot <= week()
        && shortStr(request.resource.data.message, 500)
        && (request.resource.data.get('code', null) == null
            || (request.resource.data.code is string && request.resource.data.code.size() == 4))
        // 완료 알림(mission·praise)은 지금 열린 주차만(지난 주차는 마감). 추가 쪽지(note)는 완료한 지난 주차에도 된다
        && (((request.resource.data.kind == 'mission' && request.resource.data.slot < 3 && request.resource.data.slot == week()
               && missionCardOk(string(request.resource.data.slot)))
             || (request.resource.data.kind == 'praise' && request.resource.data.slot == 3 && request.resource.data.slot == week()
               && request.resource.data.message.size() >= 10
               && praiseCardOk()))
            && id == myReceiver() + '_' + string(request.resource.data.slot)
            && doneIn(getAfter(myMissions()).data, string(request.resource.data.slot))
          || (request.resource.data.kind == 'note'
              && !('card' in request.resource.data)
              && request.resource.data.message.size() > 0
              && doneIn(get(myMissions()).data, string(request.resource.data.slot))
              && noteCount(getAfter(myMissions()).data, string(request.resource.data.slot))
                   == noteCount(get(myMissions()).data, string(request.resource.data.slot)) + 1
              && noteCount(getAfter(myMissions()).data, string(request.resource.data.slot)) <= 5
              && id == myReceiver() + '_' + string(request.resource.data.slot) + '_n'
                       + string(noteCount(getAfter(myMissions()).data, string(request.resource.data.slot)))));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
        && request.resource.data.hidden is bool;
    }
    // 쪽지 신고: 받는 사람이 자기에게 온 쪽지 하나를 운영자에게 알린다(문서 ID = 쪽지 ID, 한 번만).
    match /noteFlags/{id} {
      allow get: if linked() && get(/databases/$(database)/documents/deliveries/$(id)).data.receiverPid == myPid();
      allow read, delete: if isAdmin();
      allow create: if linked()
        && get(/databases/$(database)/documents/deliveries/$(id)).data.receiverPid == myPid()
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // 미션 슬롯 잠금 (도전 미션 응모권 보호)
    //  - 미션 진행 단계에만, 지금 열린 주차(config.week)의 슬롯만 바꿀 수 있다. 아직 안 열린 주차도, 지난 주차도 거부한다
    //    (사용자가 정함, 11/23: 주차마다 마감 — 다음 주차를 열면 그 전 주차의 카드 고르기·완료 표시가 막힌다. 몰아서 하기 방지.
    //     받는 사람의 인증은 지난 주차도 그대로 된다. 완료한 주차의 추가 쪽지(notes)도 그대로 된다)
    //  - 완료 표시(done)는 되돌릴 수 없고, 그 주차 완료 알림(deliveries/받는사람_주차)과 한 묶음으로만 켤 수 있다.
    //  - 완료했거나, 완료 표시 전이라도 그 슬롯 코드가 이미 인증된 1·2주차 슬롯은 고른 카드(난이도)를 바꿀 수 없다.
    //    (쪽지로 코드를 먼저 보내 인증받은 뒤 도전 카드로 바꾸는 것을 막는다)
    //  - 3주차 슬롯에는 칭찬 카드(칭찬 한 줄만) 또는 보통·도전 카드(칭찬 한 줄과 함께)가 들어간다. 쉬움은 없다(칭찬만이 쉬움 몫).
    //    1·2주차처럼, 완료했거나 코드가 인증된 뒤에는 카드를 바꿀 수 없다.
    //  - 추가 쪽지 수(notes)는 줄일 수 없고 주차마다 5건까지.
    function choiceIn(d, s) { return d.get(['choices', s], null); }
    function doneIn(d, s) { return d.get(['done', s], false) == true; }
    // 카드 번호(cardId)는 난이도와 맞아야 한다: e1~ 쉬움, n1~ 보통, h1~ 도전, 칭찬 카드는 praise (src/lib/constants.js MISSION_CARDS).
    // 쉬운 카드를 "도전"이라고 적어 추가 응모권을 받는 것을 막는다. 카드 글이 목록과 같은지는 집계(scoring.js)가 확인한다.
    function cardIdOk(c) {
      return (c.level == 'easy' && c.cardId.matches('e[0-9]{1,2}'))
        || (c.level == 'normal' && c.cardId.matches('n[0-9]{1,2}'))
        || (c.level == 'hard' && c.cardId.matches('h[0-9]{1,2}'))
        || (c.level == 'praise' && c.cardId == 'praise');
    }
    function choiceShapeOk(c, levels) {
      return c == null
        || (c.keys().hasOnly(['cardId', 'level', 'text'])
            && c.get('level', '') in levels
            && shortStr(c.get('cardId', ''), 20)
            && shortStr(c.get('text', ''), 200)
            && cardIdOk(c));
    }
    // 칸 이름은 '1','2','3'만. 완료 표시(done)는 true만 쓸 수 있다
    // (문자열·숫자를 넣으면 규칙의 "완료 알림과 한 묶음" 확인을 피하면서 화면에는 완료처럼 보일 수 있었다).
    function slotMapOk(m) { return m is map && m.keys().hasOnly(['1', '2', '3']); }
    function mapsShapeOk(d) {
      return slotMapOk(d.get('choices', {})) && slotMapOk(d.get('notes', {})) && slotMapOk(d.get('done', {}))
        && d.get(['done', '1'], true) == true && d.get(['done', '2'], true) == true && d.get(['done', '3'], true) == true;
    }
    function slotSame(before, s) {
      return choiceIn(request.resource.data, s) == choiceIn(before, s)
        && doneIn(request.resource.data, s) == doneIn(before, s);
    }
    function slotRedeemed(pid, s) {
      return exists(/databases/$(database)/documents/redemptions/$(get(/databases/$(database)/documents/giverCodes/$(pid)).data.codes[s]));
    }
    // 완료 표시를 새로 켜면 같은 묶음에 그 주차 완료 알림이 있어야 한다
    function doneWithDelivery(before, s) {
      return doneIn(before, s) || !doneIn(request.resource.data, s)
        || existsAfter(/databases/$(database)/documents/deliveries/$(myReceiver() + '_' + s));
    }
    function missionSlotOk(pid, before, s) {
      return slotOkWith(pid, before, s, ['easy', 'normal', 'hard']);
    }
    function slotOkWith(pid, before, s, levels) {
      return slotSame(before, s)
        || (int(s) == week()
            && !(doneIn(before, s) && !doneIn(request.resource.data, s))
            && choiceShapeOk(choiceIn(request.resource.data, s), levels)
            && doneWithDelivery(before, s)
            && (choiceIn(request.resource.data, s) == choiceIn(before, s)
                || !(doneIn(before, s) || slotRedeemed(pid, s))
                // 3주차 "칭찬만"으로 바꾸는 것은 추가분이 없어 잠근 뒤에도 된다(대상이 칭찬 알림보다 먼저 코드를 넣은 경우)
                || (choiceIn(request.resource.data, s) != null && choiceIn(request.resource.data, s).level == 'praise')));
    }
    // 쪽지 수는 그대로이거나, 같은 묶음에 그 순번의 쪽지(받는사람_주차_n새순번)가 있을 때만 1 오른다(가짜 "+쪽지 3" 표시 방지)
    function noteSlotOk(before, s) {
      let n0 = noteCount(before, s);
      let n1 = noteCount(request.resource.data, s);
      return n1 == n0
        || (n1 == n0 + 1 && n1 <= 5
            && existsAfter(/databases/$(database)/documents/deliveries/$(myReceiver() + '_' + s + '_n' + string(n1))));
    }
    function notesOk(before) {
      return noteSlotOk(before, '1') && noteSlotOk(before, '2') && noteSlotOk(before, '3');
    }
    function missionsOk(pid, before) {
      return request.resource.data.keys().hasOnly(['choices', 'done', 'notes', 'n'])
        && mapsShapeOk(request.resource.data)
        && missionSlotOk(pid, before, '1') && missionSlotOk(pid, before, '2') && slotOkWith(pid, before, '3', ['praise', 'normal', 'hard'])
        && notesOk(before)
        && bumped();
    }
    match /giverMissions/{pid} {
      allow read: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow create: if linked() && myPid() == pid && phase() == 1 && missionsOk(pid, {});
      allow update: if linked() && myPid() == pid && phase() == 1 && missionsOk(pid, resource.data);
    }

    // 진행 상황(완료 알린 미션 수, 프로필 작성, 최근 접속 등): 본인과 운영자만 읽는다.
    // 다른 참여자에게 실시간으로 보이면, 내가 미션을 받은 순간 누구 숫자가 올랐는지로 마니또가 드러난다.
    // 파트별 순위는 운영자가 주 1회 public/board에 발표한 것만 본다.
    // 완료 수는 열린 주차를 넘겨 올릴 수 없다(그대로 두는 것은 된다). 파트 주간 순위는 이 값이 아니라 giverMissions.done으로 센다.
    // 최근 접속(lastSeen)은 서버 시각으로만 쓴다.
    function progressOk(before) {
      return request.resource.data.keys().hasOnly(['profileDone', 'cluesVer', 'doneCount', 'guessed', 'lastSeen', 'n'])
        && request.resource.data.get('profileDone', false) is bool
        && request.resource.data.get('guessed', false) is bool
        && request.resource.data.get('cluesVer', 0) is int
        && request.resource.data.get('doneCount', 0) is int
        && request.resource.data.get('doneCount', 0) >= 0
        && (request.resource.data.get('doneCount', 0) <= week()
            || request.resource.data.get('doneCount', 0) == before.get('doneCount', 0))
        && (request.resource.data.get('lastSeen', null) == before.get('lastSeen', null)
            || request.resource.data.get('lastSeen', null) == request.time)
        && bumped();
    }
    match /progress/{pid} {
      allow read: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow create: if linked() && myPid() == pid && progressOk({});
      allow update: if linked() && myPid() == pid && progressOk(resource.data);
    }

    // "받은 게 없어요" 신고: 마니또가 완료를 알렸는데 받은 것이 없을 때 받는 사람이 주차별로 남긴다.
    // 문서 ID = 받는사람ID_주차. 본인, 그 사람의 마니또, 운영자만 읽는다.
    // 취소는 지우지 않고 active를 false로 바꾼다(쓴 횟수 n이 남아서 반복 요청이 보인다).
    match /reports/{rid} {
      allow get: if linked() && rid.split('_')[0] == myPid();
      allow get: if linked() && rid.split('_')[0] == myReceiver();
      allow read: if isAdmin();
      allow create: if linked() && phase() >= 1 && phase() <= 3
        && request.resource.data.keys().hasOnly(['receiverPid', 'slot', 'active', 'createdAt', 'n'])
        && request.resource.data.receiverPid == myPid()
        && request.resource.data.slot is int
        && request.resource.data.slot >= 1 && request.resource.data.slot <= week()
        && rid == myPid() + '_' + string(request.resource.data.slot)
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && bumped();
      allow update: if linked() && rid.split('_')[0] == myPid() && phase() >= 1 && phase() <= 3
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'createdAt', 'n'])
        && request.resource.data.active is bool
        && (request.resource.data.createdAt == resource.data.get('createdAt', null) || request.resource.data.createdAt == request.time)
        && bumped();
    }
    // 운영자의 주차별 확인 결과: received(받았음 → 마니또의 미션 인정) / missing(못 받음 → 받는 사람에게 보상).
    // 신고가 없어도 남길 수 있다(받고도 인증하지 않은 경우). 집계 단계까지 바꿀 수 있다.
    function verdictShapeOk(rid) {
      return phase() >= 1 && phase() <= 4
        && request.resource.data.keys().hasOnly(['receiverPid', 'slot', 'verdict', 'at'])
        && request.resource.data.verdict in ['received', 'missing']
        && request.resource.data.slot is int
        && request.resource.data.slot >= 1 && request.resource.data.slot <= 3
        && rid == request.resource.data.receiverPid + '_' + string(request.resource.data.slot);
    }
    match /verdicts/{rid} {
      allow get: if linked() && rid.split('_')[0] == myPid();
      allow get: if linked() && rid.split('_')[0] == myReceiver();
      allow read: if isAdmin();
      // "못 받음"(missing)은 마니또가 그 미션의 응모권을 잃는 결정이라 처음 운영자만 정하고, 바꾸고, 취소한다.
      // 공동 운영자는 "받았음"(received)만 남기고 취소할 수 있다.
      allow create: if isAdmin() && verdictShapeOk(rid)
        && (request.resource.data.verdict == 'received' || isOwner());
      allow update: if isAdmin() && verdictShapeOk(rid)
        && ((request.resource.data.verdict == 'received' && resource.data.verdict == 'received') || isOwner());
      allow delete: if isAdmin() && phase() >= 1 && phase() <= 4
        && (resource.data.verdict != 'missing' || isOwner());
    }

    // 단서: 문서 ID = 받는사람ID_순번.
    //  - 0~5번: 마니또가 자기 프로필 답을 대상 앞으로 쓴다. 운영자가 공개한 개수만큼만 받는 사람이 읽는다.
    //  - 6번(파트 단서): 배정할 때 운영자 브라우저가 "마니또의 파트"를 써 둔다.
    //    최종 지목 단계(2)부터 받는 사람이 읽는다. 참여자는 쓸 수 없어서 거짓으로 바꿀 수 없다.
    // 다시 배정하면 지난 회차 단서(예전 마니또의 답)는 읽을 수 없고, 새 마니또가 앱을 열 때 지금 회차로 다시 쓴다.
    match /clues/{id} {
      // 운영자는 단서를 읽는다(거짓 단서 확인, 집계 때 "단서를 다 채웠는지" 확인). 운영자는 참여하지 않는다.
      allow read: if isAdmin();
      allow get: if linked()
        && resource.data.receiverPid == myPid()
        && resource.data.get('ver', -1) == assignVer()
        && ((resource.data.idx < 6 && resource.data.idx < cfg().cluesReleased)
            || (resource.data.idx == 6 && phase() >= 2));
      // 비어 있던 칸은 늦게라도 쓸 수 있다(공개된 칸이어도).
      allow create: if clueWriteOk(id);
      // 이미 공개된 칸(idx < cluesReleased)은 답을 바꿀 수 없다(대상이 본 단서가 나중에 바뀌지 않게).
      // 단, 같은 답으로 다시 쓰기(프로필 저장 때 6칸을 다시 씀)와
      // 지난 회차 단서를 지금 회차로 덮어쓰기(다시 배정한 경우)는 된다.
      allow update: if clueWriteOk(id)
        && (request.resource.data.idx >= cfg().get('cluesReleased', 0)
            || request.resource.data.answer == resource.data.answer
            || resource.data.get('ver', -1) != assignVer());
      allow create, update: if isAdmin() && phase() == 0
        && request.resource.data.idx == 6
        && request.resource.data.ver is int
        && request.resource.data.answer is string
        && request.resource.data.answer.size() > 0 && request.resource.data.answer.size() <= 40
        && id == request.resource.data.receiverPid + '_6';
    }
    // 단서 답의 형식: 고르기 문항은 보기 중 하나, 직접 쓰기 문항은 최소 글자 수. src/lib/constants.js의 PROFILE_QUESTIONS와 같아야 한다
    // (tests/logic.test.js가 확인한다). 사실인지는 확인할 수 없어서, 운영자가 단서를 읽을 수 있게 했다.
    function clueAnswerOk(i, a) {
      return shortStr(a, 60) && a.size() > 0 && (
        (i == 0 && a in ["아이스 아메리카노", "따뜻한 커피", "라떼·달달한 커피", "차·기타 음료", "물만 마심"])
        || (i == 1 && a in ["구내식당에서 먹음", "구내식당 테이크아웃", "밖에서·도시락", "자주 거름"])
        || (i == 2 && a in ["8시 전", "8~9시", "9시 이후"])
        || (i == 3 && a.trim().size() >= 2)
        || (i == 4 && a.trim().size() >= 2)
        || (i == 5 && a.trim().size() >= 2));
    }
    // 최종 지목 단계(2)까지만 쓴다: 지목이 마감된 뒤에 프로필을 채워 "단서 6개를 냈다"는 조건(은신 응모권)만 맞추지 못하게.
    function clueWriteOk(id) {
      return linked() && phase() <= 2
        && request.resource.data.keys().hasOnly(['receiverPid', 'idx', 'answer', 'ver', 'n'])
        && request.resource.data.ver == assignVer()
        && request.resource.data.receiverPid == myReceiver()
        && request.resource.data.idx is int
        && request.resource.data.idx >= 0 && request.resource.data.idx < 6
        && clueAnswerOk(request.resource.data.idx, request.resource.data.answer)
        && id == request.resource.data.receiverPid + '_' + string(request.resource.data.idx)
        && bumped();
    }

    // 운영자의 "대상이 기다리고 있어요" 알림: 그 사람의 마니또만 읽는다(누가 받은 게 없는지 다른 참여자에게 보이지 않게).
    match /nudges/{receiverPid} {
      allow get: if linked() && receiverPid == myReceiver();
      allow read, write: if isAdmin();
    }

    match /guesses/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow create, update: if linked() && myPid() == pid && phase() == 2
        && request.resource.data.keys().hasOnly(['guessPid', 'createdAt', 'n'])
        && request.resource.data.guessPid is string
        && request.resource.data.guessPid != pid
        && exists(/databases/$(database)/documents/roster/$(request.resource.data.guessPid))
        && request.resource.data.createdAt == request.time
        && bumped();
    }

    // 주차별 중간 추측: { guesses: { "1": pid, "2": pid, "3": pid }, n }. 맞았는지는 알려 주지 않고 기록만 한다
    // (송년회에서 "몇 주차부터 알아챘나"를 공개). 본인·운영자만 읽는다. 미션 진행 단계에, 열린 주차(config.week) 칸만 쓰고 바꾼다.
    function midGuessOk(before) {
      let after = request.resource.data.get('guesses', {});
      let w = string(week());
      return request.resource.data.keys().hasOnly(['guesses', 'n'])
        && after is map
        && after.diff(before.get('guesses', {})).affectedKeys().hasOnly([w])
        && (!(w in after) || (after[w] is string && after[w] != myPid()
            && exists(/databases/$(database)/documents/roster/$(after[w]))))
        && bumped();
    }
    match /midGuesses/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow create: if linked() && myPid() == pid && phase() == 1 && midGuessOk({});
      allow update: if linked() && myPid() == pid && phase() == 1 && midGuessOk(resource.data);
    }

    // ── 수호천사 ──────────────────────────────────────────────────────────
    // 마니또가 미션을 안 해서 받은 게 없는 사람에게, 지원한 참여자를 운영자가 몰래 연결한다(응모권과 연결됨, prizes.js angel*).
    // 지원: { active, at, n } 본인만 쓰고 본인·운영자만 읽는다. 미션 진행 단계에만
    // (먼저 지원한 순서대로 연결되므로, 준비 단계에 먼저 가입한 사람이 앞서 지원하지 못하게 출발선을 미션 시작으로 맞춘다).
    match /angelVolunteers/{pid} {
      allow get: if linked() && myPid() == pid;
      allow read: if isAdmin();
      allow create, update: if linked() && myPid() == pid && phase() == 1
        && request.resource.data.keys().hasOnly(['active', 'at', 'n'])
        && request.resource.data.active is bool
        && request.resource.data.at == request.time
        && bumped();
    }
    // 연결: angels/{받는사람} = { angelPid, at }. 운영자가 미션 진행 단계에. 지원 중인 참여자만, 받는 사람 본인·그 사람의 마니또는 안 된다.
    // 수호천사 미션이 한 번이라도 오면 바꾸거나 풀 수 없다(누구에게 응모권을 줄지 흔들리지 않게).
    function angelOk(r) {
      let a = request.resource.data.angelPid;
      return request.resource.data.keys().hasOnly(['angelPid', 'at'])
        && a is string && a != r
        && get(/databases/$(database)/documents/angelVolunteers/$(a)).data.active == true
        && get(/databases/$(database)/documents/assignments/$(a)).data.receiverPid != r
        && request.resource.data.at == request.time;
    }
    function noAngelGiftYet(r) {
      return !exists(/databases/$(database)/documents/angelGifts/$(r + '_1'))
        && !exists(/databases/$(database)/documents/angelGifts/$(r + '_2'));
    }
    match /angels/{receiverPid} {
      allow list: if linked() && resource.data.angelPid == myPid();
      allow read: if isAdmin();
      allow create: if isAdmin() && phase() == 1 && angelOk(receiverPid);
      allow update: if isAdmin() && phase() == 1 && angelOk(receiverPid) && noAngelGiftYet(receiverPid);
      allow delete: if isAdmin() && phase() == 1 && noAngelGiftYet(receiverPid);
    }
    // 수호천사 미션: angelGifts/{받는사람}_{1|2} = { receiverPid, k, text(한 것), message, createdAt } — 보낸 사람 정보는 없다.
    // 받는 사람이 확인하면 { confirmed: true, review, confirmedAt }가 더해진다(한 번만). 미션 진행 단계에만.
    function myAngelFor(r) {
      return exists(/databases/$(database)/documents/angels/$(r))
        && get(/databases/$(database)/documents/angels/$(r)).data.angelPid == myPid();
    }
    match /angelGifts/{id} {
      allow list: if linked() && resource.data.receiverPid == myPid();
      allow get: if linked() && (id.split('_')[0] == myPid() || myAngelFor(id.split('_')[0]));
      allow read, delete: if isAdmin();
      allow create: if linked() && phase() == 1
        && request.resource.data.keys().hasOnly(['receiverPid', 'k', 'text', 'message', 'createdAt'])
        && request.resource.data.receiverPid is string
        && myAngelFor(request.resource.data.receiverPid)
        && request.resource.data.k in [1, 2]
        && id == request.resource.data.receiverPid + '_' + string(request.resource.data.k)
        && shortStr(request.resource.data.text, 100) && request.resource.data.text.trim().size() >= 2
        && shortStr(request.resource.data.message, 500)
        && request.resource.data.createdAt == request.time;
      allow update: if linked() && phase() >= 1 && phase() <= 2
        && resource.data.receiverPid == myPid()
        && resource.data.get('confirmed', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed', 'review', 'confirmedAt'])
        && request.resource.data.confirmed == true
        && request.resource.data.review is string
        && request.resource.data.review.trim().size() >= 10 && request.resource.data.review.size() <= 500
        && request.resource.data.confirmedAt == request.time;
    }

    // 받는 사람 → 내 마니또 익명 한마디: { receiverPid, slot, message, createdAt }, 문서 ID "받는사람_주차"라 주차마다 한 번(고칠 수 없음).
    // 받는 사람·그 사람의 마니또·운영자만 읽는다. 보낸 사람(받는 사람)은 마니또가 원래 알고 있는 사람이라 정체가 드러나지 않는다.
    match /toManito/{id} {
      allow list: if linked() && (resource.data.receiverPid == myPid() || resource.data.receiverPid == myReceiver());
      allow read, delete: if isAdmin();
      allow create: if linked() && phase() >= 1 && phase() <= 2
        && request.resource.data.keys().hasOnly(['receiverPid', 'slot', 'message', 'createdAt'])
        && request.resource.data.receiverPid == myPid()
        && request.resource.data.slot is int && request.resource.data.slot >= 1 && request.resource.data.slot <= week()
        && id == myPid() + '_' + string(request.resource.data.slot)
        && request.resource.data.message is string
        && request.resource.data.message.trim().size() > 0 && request.resource.data.message.size() <= 200
        && request.resource.data.createdAt == request.time;
    }

    // 운영 메모: 재배정 시 지울 코드 목록
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    // 결과. 집계 단계(4)에는 통째로 다시 쓸 수 있지만 추첨 결과(draws)는 비어 있어야 한다.
    // 공개 단계(5)의 추첨 결과(src/lib/scoring.js resolvePrizes가 읽는 모양. 칸 이름은 tests/logic.test.js가 상품 설정과 같은지 확인):
    //   seed            현장에서 정한 숫자. 한 번 넣으면 바꿀 수 없다(2등 동점과 6등 사이트 추첨에 쓰므로, 결과를 보고 고르지 못하게).
    //   grand·t4·t5     현장에서 종이로 뽑힌 이름 { winners: [pid…] }. 운영자가 입력하고, 6등을 뽑기 전까지는 고칠 수 있다(잘못 입력했을 때).
    //   t6              사이트가 뽑은 6등 { winners }. 숫자가 있어야 쓸 수 있고, 쓴 뒤에는 추첨 결과 전체를 바꿀 수 없다.
    //   (2등·3등은 저장하지 않는다: 응모권 표·공감 수·숫자로 누구 화면에서나 같은 값이 계산된다)
    function drawsOf(d) { return d.get('draws', {}); }
    function winnersOk(m, max) { return m is map && m.keys().hasOnly(['winners']) && m.winners is list && m.winners.size() <= max; }
    function drawsShapeOk(d) {
      return d.keys().hasOnly(['seed', 'grand', 't4', 't5', 't6'])
        && d.get('seed', '0') is string && d.get('seed', '0').size() > 0 && d.get('seed', '0').size() <= 20
        && winnersOk(d.get('grand', { 'winners': [] }), 1)
        && winnersOk(d.get('t4', { 'winners': [] }), 60)
        && winnersOk(d.get('t5', { 'winners': [] }), 60)
        && winnersOk(d.get('t6', { 'winners': [] }), 60)
        && (!('t6' in d) || 'seed' in d);
    }
    match /results/{docId} {
      allow read: if (linked() && phase() >= 5) || isAdmin();
      allow create, update: if isAdmin() && phase() == 4
        && drawsOf(request.resource.data).size() == 0;
      // 공개 단계: 추첨 결과와 발표 화면 진행(step: 몇 번째 장면까지 공개했는지)만
      allow update: if isAdmin() && phase() == 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['draws', 'step'])
        && request.resource.data.get('step', 0) is int
        && (drawsOf(request.resource.data) == drawsOf(resource.data)
            || (!('t6' in drawsOf(resource.data))
                && drawsShapeOk(drawsOf(request.resource.data))
                && (!('seed' in drawsOf(resource.data)) || drawsOf(request.resource.data).get('seed', '') == drawsOf(resource.data).seed)));
    }
  }
}
