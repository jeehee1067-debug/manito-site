{
  "name": "manito-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "firebase emulators:exec --only auth,firestore --project demo-manito \"vite --mode emulator\"",
