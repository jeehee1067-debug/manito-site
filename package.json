  "dependencies": {
    "firebase": "10.14.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "firebase-tools": "15.34.1",
    "vite": "5.4.11"
  }
}
